# Vite client env vars (must be prefixed with VITE_ to be exposed to the bundle)
# Copy to client/.env.local for local dev. Never commit secrets here.

# Base URL of the API server. Leave blank in dev to use the Vite proxy.
# Example: https://api.example.com
VITE_SERVER_URL=

# Public WhatsApp contact number (used on the landing page).
VITE_WHATSAPP_NUMBER=9779800000000

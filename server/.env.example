# ─── Required in production ───────────────────────────────────────────────────

MONGODB_URI=mongodb://localhost:27017/manpoweros
JWT_SECRET=replace_with_a_long_random_secret
CORS_ORIGINS=https://yourdomain.com
API_BASE_URL=https://api.yourdomain.com
CLIENT_URL=https://yourdomain.com

# ─── Optional ─────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=5000
JWT_EXPIRES_IN=7d
MAX_FILE_SIZE=10485760

# ─── Cloudinary — required for document/photo uploads ────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── SMTP Email — optional but recommended ────────────────────────────────────
# When set, the app sends: stage-change alerts, staff invites, password resets.
# Works with any SMTP provider (Gmail, Mailgun, SendGrid, etc.)
# Leave blank to disable all outbound email (app still works, no emails sent).
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME=ManpowerOS
SMTP_FROM_EMAIL=no-reply@yourdomain.com

# ─── Google Vision — optional, enables passport OCR ──────────────────────────
# GOOGLE_VISION_KEY_FILE=/path/to/service-account.json
